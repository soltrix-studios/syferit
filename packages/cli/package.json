{
  "name": "@syferit/cli",
  "version": "1.0.1",
  "description": "Universal command-line tool for Syferit code protection",
  "author": "Soltrix Studios",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "syferit": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@syferit/core": "^1.0.1",
    "@syferit/wasm": "^1.0.1",
    "@syferit/llvm": "^1.0.1",
    "@syferit/python": "^1.0.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soltrix-studios/syferit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://syferit.soltrixstudios.com",
  "files": [
    "dist",
    "README.md"
  ]
}
